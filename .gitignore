# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets)
.env*
.env.local
.env
.env.production
.env.development
.env.staging
.env.example

# playwright repro / shared-terminal artifacts
playwright.repro.config.ts
test-results/
probe*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/freebuff-sites-build/
/.open-next/
/.wrangler/
*.bak
